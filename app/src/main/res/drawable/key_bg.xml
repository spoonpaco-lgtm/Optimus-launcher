<?xml version="1.0" encoding="utf-8"?>
<!-- Retro drukknop: glanzende bovenhelft, donkere onderhelft, amber LED-streep -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><corners android:radius="6dp" /><solid android:color="#000000" /></shape></item>
            <item android:top="2dp"><shape><corners android:radius="6dp" />
                <gradient android:angle="270" android:startColor="#1A1A1F" android:centerColor="#101014" android:endColor="#08080A" />
                <stroke android:width="1dp" android:color="#000000" /></shape></item>
            <item android:gravity="bottom" android:bottom="8dp" android:left="22dp" android:right="22dp" android:height="3dp">
                <shape><corners android:radius="2dp" /><solid android:color="#FFB26B" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp"><shape><corners android:radius="6dp" /><solid android:color="#000000" /></shape></item>
            <item android:bottom="3dp"><shape><corners android:radius="6dp" />
                <gradient android:angle="270" android:startColor="#2A2A31" android:centerColor="#16161B" android:endColor="#0B0B0E" />
                <stroke android:width="1dp" android:color="#000000" /></shape></item>
            <item android:bottom="3dp" android:left="1dp" android:right="1dp" android:gravity="top" android:height="1dp">
                <shape><solid android:color="#30FFFFFF" /></shape></item>
            <item android:gravity="bottom" android:bottom="11dp" android:left="22dp" android:right="22dp" android:height="2dp">
                <shape><corners android:radius="2dp" /><solid android:color="#FF8A1F" /></shape></item>
        </layer-list>
    </item>
</selector>
