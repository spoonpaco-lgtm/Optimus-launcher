<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OptimusLauncher" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@color/tile</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">20sp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Status">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">18dp</item>
        <item name="android:textColor">@color/fg_dim</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
