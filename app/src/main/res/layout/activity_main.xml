<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="14dp">

    <!-- Statusbalk -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView android:id="@+id/st_net" style="@style/Status" android:text="● Internet" />
        <TextView android:id="@+id/st_gps" style="@style/Status" android:text="● GPS" />
        <TextView android:id="@+id/st_phone" style="@style/Status" android:text="● Telefoon" />
        <TextView android:id="@+id/st_log" style="@style/Status" android:text="● Autolog" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView android:id="@+id/st_tank" style="@style/Status" android:text="⛽ tank ?" />
    </LinearLayout>

    <!-- Klok + snelheid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/fg"
                android:textSize="56sp"
                android:fontFamily="sans-serif-thin" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fg_dim"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/fg"
                android:textSize="88sp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="14dp"
                android:text="km/u"
                android:textColor="@color/fg_dim"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Ritregel -->
    <TextView
        android:id="@+id/trip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:textColor="@color/fg_dim"
        android:textSize="16sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Alleen zichtbaar als Android Auto niet verbindt -->
    <ImageButton
        android:id="@+id/btn_offline"
        style="@style/Tile"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:visibility="gone"
        android:src="@drawable/ic_nav"
        android:contentDescription="Offline navigeren" />

    <!-- Knoppen -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="2"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="false">

        <ImageButton android:id="@+id/btn_aa" style="@style/Tile" android:layout_columnSpan="2" android:src="@drawable/ic_aa" android:contentDescription="@string/aa" />
        <ImageButton android:id="@+id/btn_radio" style="@style/Tile" android:src="@drawable/ic_radio" android:contentDescription="@string/radio" />
        <ImageButton android:id="@+id/btn_eq" style="@style/Tile" android:src="@drawable/ic_eq" android:contentDescription="@string/eq" />
        <ImageButton android:id="@+id/btn_fuel" style="@style/Tile" android:src="@drawable/ic_fuel" android:contentDescription="@string/fuel" />
        <ImageButton android:id="@+id/btn_apps" style="@style/Tile" android:src="@drawable/ic_apps" android:contentDescription="@string/apps" />
        <ImageButton android:id="@+id/btn_settings" style="@style/Tile" android:src="@drawable/ic_settings" android:contentDescription="@string/settings" />
        <ImageButton android:id="@+id/btn_update" style="@style/Tile" android:src="@drawable/ic_update" android:contentDescription="@string/update" />

    </GridLayout>

</LinearLayout>
