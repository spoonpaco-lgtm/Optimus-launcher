<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/fg"
        android:textSize="64sp"
        android:fontFamily="sans-serif-thin" />

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColor="@color/fg_dim"
        android:textSize="20sp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="2"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="false">

        <Button android:id="@+id/btn_nav" style="@style/Tile" android:text="@string/nav" />
        <Button android:id="@+id/btn_music" style="@style/Tile" android:text="@string/music" />
        <Button android:id="@+id/btn_phone" style="@style/Tile" android:text="@string/phone" />
        <Button android:id="@+id/btn_radio" style="@style/Tile" android:text="@string/radio" />
        <Button android:id="@+id/btn_apps" style="@style/Tile" android:text="@string/apps" />
        <Button android:id="@+id/btn_settings" style="@style/Tile" android:text="@string/settings" />

    </GridLayout>

</LinearLayout>
